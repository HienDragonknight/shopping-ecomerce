{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "env": {
    "NEXT_PUBLIC_API_URL": "@next_public_api_url",
    "BACKEND_URL": "@backend_url"
  },
  "functions": {
    "src/app/**": {
      "maxDuration": 30
    }
  }
}
